# =============================================================================
#  Smarter-Blinkit-2.0 — Root .gitignore
#  Covers: FastAPI backend · React/Vite frontend · Docker · IDE · OS
# =============================================================================


# =============================================================================
# 1. ENVIRONMENT VARIABLES & SECRETS  ← NEVER commit these
# =============================================================================
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.staging
.env.staging.local
.env.production
.env.production.local
*.env
.env.*

# Secret / credential sheets sometimes dropped in project root
secrets.json
secrets.yaml
secrets.yml
credentials.json
credentials.yaml
credentials.yml
service-account*.json
*_rsa
*_rsa.pub
*.pem
*.key
*.p12
*.pfx


# =============================================================================
# 2. PYTHON / FASTAPI BACKEND
# =============================================================================

# Virtual environments
venv/
.venv/
env/
ENV/
.env/          # catches "python -m venv .env" pattern

# Byte-compiled / optimised / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/
MANIFEST
pip-wheel-metadata/
*.whl

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
nosetests.xml
pytest.ini.bak

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# Jupyter / IPython
.ipynb_checkpoints/
*.ipynb

# Celery
celerybeat-schedule
celerybeat.pid

# Logs generated by the backend process
*.log
logs/
log/


# =============================================================================
# 3. LOCAL DATABASES & DATA FILES
# =============================================================================

# SQLite (local dev databases)
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# PostgreSQL local dumps / backups
*.sql
*.dump
*.pgdump
*.backup
pg_data/
postgres_data/
pgdata/

# Neo4j local data directories
neo4j_data/
neo4j/data/
neo4j/logs/
neo4j/import/
neo4j/plugins/

# Generic Docker volume mount directories
data/
docker-data/
volumes/

# CSV / data dumps that may contain PII or large datasets
# (comment out if you intentionally version-control seed CSVs)
BigBasket.csv
*.csv


# =============================================================================
# 4. REACT / VITE FRONTEND
# =============================================================================

# Dependencies
frontend/node_modules/
node_modules/

# Production build output
frontend/dist/
frontend/dist-ssr/
frontend/build/
dist/
dist-ssr/
build/

# Vite / Rollup cache
frontend/.vite/
.vite/

# ESLint cache
.eslintcache
frontend/.eslintcache

# Stylelint cache
.stylelintcache

# TypeScript build info
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# npm / yarn / pnpm debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/
.yarn/
.pnp.*
.yarn-integrity

# Parcel cache (if ever used)
.cache/
.parcel-cache/

# Storybook build output (if ever added)
storybook-static/


# =============================================================================
# 5. IDE & EDITOR FILES
# =============================================================================

# VS Code — keep extensions.json if you want to share recommended extensions
.vscode/*
!.vscode/extensions.json

# JetBrains IDEs (PyCharm, WebStorm, IntelliJ)
.idea/
*.iml
*.iws
*.ipr
out/

# Vim / Neovim swap files
*.swp
*.swo
*~
Session.vim
.netrwhist

# Emacs
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# Eclipse
.project
.classpath
.settings/


# =============================================================================
# 6. OPERATING SYSTEM FILES
# =============================================================================

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~


# =============================================================================
# 7. DOCKER & INFRASTRUCTURE
# =============================================================================

# Docker override files with local secrets
docker-compose.override.yml
docker-compose.local.yml
.docker/

# Terraform (if ever added)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json


# =============================================================================
# 8. MISCELLANEOUS GENERATED / TEMPORARY FILES
# =============================================================================

# Test images / binary blobs accidentally dropped in repo
obama.jpg
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.ico
# Exception: keep intentional frontend assets
!frontend/src/assets/**
!frontend/public/**

# Temporary files
*.tmp
*.temp
*.bak
*.orig
*.rej
tmp/
temp/
